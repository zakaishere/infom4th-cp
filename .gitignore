# Secrets and server settings: every machine keeps its own copy (never commit it).
.env
.local/
**/target/
**/__pycache__/
*.pyc
.venv/
*.log
.idea/
.vscode/
node_modules/
dist/
.env.bak

# Separate Android app project, kept outside this repository.
/lifeos-android/

# Personal scratch copies of work in progress (never committed).
draft/
# Problem banks hold private tests and solutions. Only the duel bank is tracked, because the
# backend installs it by itself (backend/src/main/resources/seed/duel-problems.json.gz).
examples/*
!examples/duel-problems/
examples/duel-problems/problem-bank.import.json*
backend/src/main/resources/seed/*.json

# Language documentation installed by frontend/scripts/install-docs.mjs (large, downloaded).
frontend/public/refdocs/
