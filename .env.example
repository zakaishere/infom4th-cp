# Create .env with random secrets: sh scripts/setup-env.sh (Linux/macOS) or scripts/setup-env.ps1 (Windows).
DB_PASSWORD=replace-with-random-secret
DB_PORT=5433
SERVER_PORT=8081
RABBITMQ_PASSWORD=replace-with-random-hex-secret
RABBITMQ_PROMETHEUS_PORT=15692
WORKER_TOKEN=replace-with-at-least-32-random-characters
# Optional initial administrator; no account is seeded by default.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Judging needs a Linux Docker engine with cgroup v2 (any modern Linux, or Docker Desktop).
JUDGE_HOST_WORK_ROOT=/var/lib/cp-judge
# ---- Judge capacity: the only numbers most deployments change ----
# A "slot" = one submission compiled and run at a time (not a participant).
# Rule of thumb: one slot per CPU core you can dedicate, and 1 GB RAM per slot.
OFFICIAL_JUDGE_SLOTS=2          # contest submissions judged at the same time
INTERNAL_JUDGE_SLOTS=1          # practice + problem validation at the same time
JUDGE_MAX_MEMORY_MB=1024        # memory per slot; problem memory limits must fit
JUDGE_LANGUAGES=CPP,CPP20,C,JAVA,PYTHON,PYPY,JAVASCRIPT,GO,RUST,KOTLIN,CSHARP,RUBY,PHP  # missing images are built on first start
# Optional (leave empty unless you know you need them):
OFFICIAL_JUDGE_MAX_SLOTS=
INTERNAL_JUDGE_MAX_SLOTS=
OFFICIAL_MEMORY_BUDGET_MB=
INTERNAL_MEMORY_BUDGET_MB=
JUDGE_HOST_ID=judge-host-1
JUDGE_HOST_MEMORY_BUDGET_MB=
JUDGE_CONTROL_INTERVAL_SECONDS=5
# The address people open (use the server IP or domain) and the website port.
WEB_PORT=80
PUBLIC_URL=http://localhost
# Contest dates and times are shown in this time zone for everyone (IANA name, e.g. Africa/Casablanca).
DISPLAY_TIMEZONE=UTC
CORS_ORIGINS=http://localhost
# SMTP is required to deliver password reset links.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
